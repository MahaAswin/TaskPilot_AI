# TaskPilot AI - Enterprise Environment Configuration Example

# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/taskpilot_ai

# Security & Authentication
JWT_SECRET=super_secret_production_jwt_key_change_me_in_prod
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_key

# AI Multi-Provider Orchestration & Priority Chain (Gemini -> Grok -> Ollama -> Mock Failsafe)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER_PRIORITY=gemini,grok,ollama,mock

# AI Providers API Keys
GEMINI_API_KEY=
GROK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# YouTube Data API Key
YOUTUBE_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Security Agent API Keys (VirusTotal, urlscan.io, Abstract Email & Abstract Phone API)
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
# Google OAuth 2.0 & Gmail API Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/email/google/callback


# SMTP Email Dispatcher (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=






# Rate Limiting & Logs
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
