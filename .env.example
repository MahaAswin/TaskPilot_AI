# TaskPilot AI - Enterprise Environment Configuration Example

# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/taskpilot_ai

# Security & Authentication
JWT_SECRET=super_secret_production_jwt_key_change_me_in_prod
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_key

# AI Providers API Keys
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Rate Limiting & Logs
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
