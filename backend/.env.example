# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/taskpilot-ai?retryWrites=true&w=majority

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# AI Provider Priority Chain: gemini -> grok -> ollama -> mock
AI_PROVIDER=gemini
AI_PRIMARY_PROVIDER=gemini
AI_PROVIDER_PRIORITY=gemini,grok,ollama,mock

# AI Credentials (add your keys here)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROK_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Client Router Configuration
CLIENT_URL=http://localhost:5173
