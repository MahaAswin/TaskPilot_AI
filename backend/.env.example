# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/taskpilot-ai?retryWrites=true&w=majority

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# AI Provider Priority Chain: gemini -> grok -> ollama -> mock
AI_PROVIDER=gemini
AI_PRIMARY_PROVIDER=gemini
AI_PROVIDER_PRIORITY=gemini,grok,ollama,mock

# AI Credentials (add your keys here)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROK_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Security Agent API Keys (VirusTotal, urlscan.io, Abstract Email & Abstract Phone API)
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
# Google OAuth 2.0 & Gmail API Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/email/google/callback


# SMTP Email Dispatcher (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@taskpilot.ai





# Client Router Configuration
CLIENT_URL=http://localhost:5173

